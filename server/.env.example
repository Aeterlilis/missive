# 复制为 .env 并填入你的配置：  cp .env.example .env

# ─── 大模型 API ──────────────────────────────────────────────
# 任意 OpenAI 兼容的视觉模型都行。几个常见选择：
#   OpenAI:      https://api.openai.com/v1   模型 gpt-4o-mini
#   OpenRouter:  https://openrouter.ai/api/v1 模型 openai/gpt-4o
#   Groq:        https://api.groq.com/openai/v1（注意 Groq 多为非视觉，需确认模型支持图片）
OPENAI_API_KEY=sk-在这里填你的key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 回答长度上限（手写呈现，不宜过长）
MAX_TOKENS=280

# ─── 服务端口 ─────────────────────────────────────────────────
# 监听 0.0.0.0 以便局域网内 Boox 设备访问
PORT=3000
